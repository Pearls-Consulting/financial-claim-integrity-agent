# Copy to .env and fill in. NEVER commit real secrets.

# --- app ---
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173

# --- auth / session ---------------------------------------------------------
# One reviewer login (single role). Same session method as the prequalification
# agent: HS256 JWT in an httpOnly cookie. A blank AUTH_PASSWORD disables login.
AUTH_EMAIL=reviewer@sdb.local
AUTH_NAME=Vendor Management Specialist
AUTH_PASSWORD=
# Long random value in production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-change-me-set-a-real-secret-in-production
SESSION_COOKIE_NAME=cia_session
SESSION_IDLE_HOURS=168          # sliding idle window (7 days) = cookie max-age
SESSION_ABSOLUTE_HOURS=720      # hard cap from login (30 days); 0 = none
COOKIE_SECURE=false             # true behind HTTPS in production

# --- AI providers -----------------------------------------------------------
# Two-seam adapter pattern proven in the prequalification agent: the model
# reads, Python validates, the human signs off.
#
#   EXTRACTOR_ENGINE = mock   -> seeded pass-through (default; no AI calls,
#                                the demo runs on deterministic rules alone)
#                    | gpt    -> GPT vision reads the pages natively, every
#                                file/chunk in parallel, page provenance on
#                                every value (analyzer-v4 shape). Azure CU is
#                                used ONLY by the evidence viewer's highlight
#                                fallback (one page per click). Use this.
#                    | azure  -> CU Layout OCR of every page + GPT structuring
#                                (the earlier, slower path; fallback)
#
#   JUDGE_ENGINE     = mock   -> verdict derived from rule findings only
#                    | gpt    -> GPT via Azure OpenAI reasons over findings
#                    | claude -> Claude reasons over findings
EXTRACTOR_ENGINE=mock
JUDGE_ENGINE=mock

# Azure Content Understanding — evidence-viewer highlight fallback on scanned
# pages (gpt engine: the ONLY CU use; azure engine: also the OCR reader)
# AZURE_CU_ENDPOINT=https://<your-resource>.services.ai.azure.com/
# AZURE_CU_KEY=
# AZURE_CU_ANALYZER=prebuilt-layout
# How many pages one evidence click may OCR (cited page + nearest neighbours)
# LOCATE_MAX_PAGES=3

# Azure OpenAI (reader + judge)
# AZURE_OPENAI_BASE_URL=https://<your-resource>.services.ai.azure.com/openai/v1/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_MODEL=gpt-5.4

# gpt engine tuning (defaults shown)
# GPT_VISION_MODEL=              # empty = AZURE_OPENAI_MODEL
# GPT_VISION_EFFORT=low          # Responses-API reasoning effort for reads
# GPT_VISION_RENDER_DPI=200      # pages go to the model as images at this DPI
# GPT_VISION_CHUNK_PAGES=5       # pages per call; a 76-page scan = 16 calls
# GPT_VISION_CONCURRENCY=12      # calls in flight; beyond ~12-16 the deployment just queues them
# GPT_VISION_MAX_OUTPUT_TOKENS=24000
# GPT_VISION_TIMEOUT_SECONDS=300
# GPT_VISION_ATTACHMENT_MAX_PAGES=3   # identity docs: first pages only
# GPT_VISION_PASSES=2            # short docs (invoice, COC...) read twice + majority vote
# GPT_VISION_CONSENSUS_MAX_PAGES=2
# GPT_VISION_VERIFY=true         # focused re-read of identifiers/totals on the header page (wins)
# EXTRACTION_CACHE=false         # true = cache model reads on disk by file content
# GPT_RECONCILE_EFFORT=low       # text-only cross-document patch
# GPT_JUDGE_EFFORT=low           # rationale write-up

# Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_JUDGE_MODEL=claude-sonnet-5

# --- ERP source -------------------------------------------------------------
# Where claims and their documents come from. The demo ships with a seeded
# mock; the production adapter targets D365 F&O (SDB's VRM claims module).
#   ERP_SOURCE = mock | d365
ERP_SOURCE=mock
# D365_BASE_URL=
# D365_TENANT_ID=
# D365_CLIENT_ID=
# D365_CLIENT_SECRET=
